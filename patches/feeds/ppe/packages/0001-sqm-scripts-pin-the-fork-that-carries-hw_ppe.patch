-PKG_SOURCE_VERSION:=77cf89e82ced9b215cc02f64fd471f5278b7d031
-PKG_VERSION:=1.8.0
+PKG_SOURCE_VERSION:=51a4009f1361dd56d8ee71ed602d115785fd7b7c
+PKG_VERSION:=1.8.2
 PKG_RELEASE:=1
 
