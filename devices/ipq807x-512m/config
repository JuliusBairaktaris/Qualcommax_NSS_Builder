#
# Every 512 MB ipq807x board except the Xiaomi AX3600, which has its own
# device directory (same image plus board-specific overlay files), and the
# MX4200 v1 (devices/ipq807x-6m-kernel).
#
# Concatenated onto devices/common/config by prepare-build.sh. See
# devices/ipq807x-1g/config for what the groups split by RAM differ in.
#

CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y


CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_cmcc_rm2-6=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_compex_wpq873=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_edimax_cax1800=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_zte_mf269=y

# Compressed swap in RAM for the boards with the least of it.
CONFIG_PACKAGE_zram-swap=y
