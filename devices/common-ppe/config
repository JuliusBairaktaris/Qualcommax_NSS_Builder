#
# PPE hardware flow-offload test images: stock OpenWrt plus LuCI and the levers
# that drive the offload. Nothing else — the point of these images is to test
# the qca_edma/qca_ppe datapath, not to ship a router build.
#
# Built from the ppe-offload branch, which carries the whole offload as one
# checkout: the switch series (PR openwrt#24806) plus the four features that
# each need a pending kernel patch (openwrt#25078, #25079, #25080, #25081) and
# the ppe-qos package (openwrt#25082). The offload lives in the kernel driver,
# so there is no NSS feed and no CONFIG_NSS_* symbol anywhere here.
#
# prepare-build.sh concatenates this with devices/<device>/config (which is just
# the subtarget) and runs `make defconfig`; COMMON=common-ppe in the workflow
# picks this file over devices/common/config.
#

CONFIG_TARGET_qualcommax=y

## Every board of the subtarget in one image set, the way the OpenWrt buildbot
## builds a target. The ath11k memory profile stays at the target default, so
## the per-RAM grouping the NSS images need does not apply.
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ALL_PROFILES=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

## Compiler cache, restored and saved by the workflow.
CONFIG_CCACHE=y
CONFIG_DEVEL=y

## Sysupgrade-only, as with the NSS images: the audience already runs OpenWrt.
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y

## The offload's levers. ppe-qos is in-tree on the branch; luci-app-ppe-qos
## comes from the luci feed, which the workflow points at the fork carrying it
## (openwrt/luci PR 8965); sqm-scripts is repinned by patches/feeds/ppe/ to the
## fork whose hw_ppe.qos drives the hardware shaper. The tc userspace and the
## sched kmods the offload is driven from are in the target's DEFAULT_PACKAGES
## on this branch.
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_ppe-qos=y
CONFIG_PACKAGE_luci-app-ppe-qos=y
