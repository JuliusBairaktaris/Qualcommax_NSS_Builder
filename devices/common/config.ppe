# PPE flavour: the qca_edma/qca_ppe hardware flow-offload track. Built from
# the ppe-offload branch, which carries no NSS feed — every CONFIG_NSS_* and
# CONFIG_ATH11K_NSS_* symbol from the common config is undefined there and
# silently dropped by defconfig. This fragment only adds what the flavour
# needs on top.

# Hardware QoS: the flowtable offload driver is in the kernel; these are the
# levers around it (shaper script, queue classifiers, their LuCI pages).
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_ppe-qos=y
CONFIG_PACKAGE_luci-app-ppe-qos=y
CONFIG_PACKAGE_dcb=y
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-sched=y
