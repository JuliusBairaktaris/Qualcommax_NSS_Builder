#!/bin/sh
# The PPE offloads routed and NAT flows from the fw4 flowtable. Turn it on
# only where the options were never set, so a choice made before a
# settings-preserving sysupgrade stands.
if [ -z "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" ]; then
	uci -q set firewall.@defaults[0].flow_offloading='1'
	uci -q set firewall.@defaults[0].flow_offloading_hw='1'
	uci -q commit firewall
fi
exit 0
