#!/bin/sh /etc/rc.common
# Reinstalls the packages kept across an update, and keeps the cron entry of
# the automatic update in line with /etc/config/ppe-update.

START=99
USE_PROCD=1

CRON=/etc/crontabs/root
TAG='# ppe-update'

cron_sync() {
	local auto hour line
	auto=$(uci -q get ppe-update.main.auto)
	hour=$(uci -q get ppe-update.main.hour || echo 4)
	line="$(( $(hexdump -n1 -e '"%u"' /dev/urandom) % 60 )) $hour * * * /usr/sbin/ppe-update auto $TAG"
	touch "$CRON"
	if [ "$auto" = 1 ]; then
		grep -q "$TAG" "$CRON" && grep -q " $hour \* \* \* " "$CRON" && return
		sed -i "/$TAG/d" "$CRON"
		echo "$line" >>"$CRON"
	else
		grep -q "$TAG" "$CRON" || return
		sed -i "/$TAG/d" "$CRON"
	fi
	/etc/init.d/cron restart
}

start_service() {
	cron_sync
	[ -s /etc/ppe-update/packages ] || return 0
	procd_open_instance restore
	procd_set_param command /usr/sbin/ppe-update restore
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger ppe-update
}

reload_service() {
	cron_sync
}
