#
# Every ipq807x board with 1 GB or more of RAM, in one image set, except the
# boards with a 6 MiB kernel partition (devices/ipq807x-6m-kernel).
#
# Concatenated onto devices/common/config by prepare-build.sh. The ppe-nss
# branch has no compile-time ath11k or NSS memory profile, so the groups split
# by RAM differ only in what their config files add: the 256 MB and 512 MB
# groups carry zram-swap, this one does not.
#
# No device-specific package pruning here: DEVICE_PACKAGES pulls in what each
# board needs (ath10k firmware, USB, 10G PHY), and disabling any of it would
# ship a broken image for the boards that do have the hardware. PER_DEVICE_ROOTFS
# is what keeps those out of the images that do not - without it every image in
# the group carries every other board's packages.
#

CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y


CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_aliyun_ap8220=y
