#
# Every ipq807x board with 1 GB or more of RAM, in one image set.
#
# Concatenated onto devices/common/config by prepare-build.sh. The group exists
# because the ath11k and NSS memory profiles are compile-time and image-wide, so
# boards can only share a build when they share a profile.
#
# Grouping is by hand. kmod-ath11k carries its own per-board profile selects,
# but they key off the single-profile choice symbol, which a multi-device build
# never sets - so the profile below is the only thing deciding, and a board
# listed in the wrong group gets an image built for the wrong amount of RAM with
# nothing in the build to say so. Keep the three groups matching that block.
#
# No device-specific package pruning here: DEVICE_PACKAGES pulls in what each
# board needs (ath10k firmware, USB, 10G PHY), and disabling any of it would
# ship a broken image for the boards that do have the hardware. PER_DEVICE_ROOTFS
# is what keeps those out of the images that do not - without it every image in
# the group carries every other board's packages.
#

CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

CONFIG_ATH11K_MEM_PROFILE_1G=y
CONFIG_NSS_MEM_PROFILE_HIGH=y

