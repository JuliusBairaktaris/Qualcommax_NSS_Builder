#!/bin/sh
# Provision a hardware SQM (hw_ppe.qos, the PPE port shaper) template. Create
# the sqm.wan section only if absent, so user-tuned settings survive
# sysupgrade.
#
# The section ships DISABLED: a shaper is only correct at ~90-95% of the rate
# YOUR line actually delivers, so there is no safe universal default. Set
# download/upload to your measured line rates (kbit/s) and enabled='1', or
# configure it in LuCI > Network > SQM.
if [ -z "$(uci -q get sqm.wan)" ]; then
	uci -q batch <<-EOI
		set sqm.wan=queue
		set sqm.wan.enabled='0'
		set sqm.wan.interface='wan'
		set sqm.wan.download='335000'
		set sqm.wan.upload='165000'
		set sqm.wan.qdisc='fq_codel'
		set sqm.wan.script='hw_ppe.qos'
		set sqm.wan.linklayer='none'
	EOI
fi
uci -q commit sqm
exit 0
