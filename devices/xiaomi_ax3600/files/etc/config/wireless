# Complete wireless config for the AX3600 (radio paths are fixed for this
# board, so shipping it statically beats first-boot detection).
#
# The interfaces ship disabled with no key, exactly as upstream's wifi detect
# leaves a board with no factory credentials. A published image cannot carry a
# working one: the key would be readable in this repo, so every flashed router
# would come up broadcasting an AP that anyone in range can join - and reach a
# LuCI whose root password is still unset. Set ssid/key over the LAN port,
# then `uci set wireless.default_radio0.disabled=0`.

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi'
	option band '5g'
	option channel '36'
	option htmode 'HE160'
	option country 'DE'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option disabled '1'
	option ssid 'OpenWrt'
	option encryption 'sae-mixed'
	option key ''
	option wnm_sleep_mode '1'
	option ieee80211k '1'
	option time_advertisement '2'
	option bss_transition '1'
	option proxy_arp '1'
	option ocv '1'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi+1'
	option band '2g'
	option channel '1'
	option htmode 'HE40'
	option country 'DE'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option disabled '1'
	option ssid 'OpenWrt'
	option encryption 'sae-mixed'
	option key ''
	option wnm_sleep_mode '1'
	option ieee80211k '1'
	option time_advertisement '2'
	option bss_transition '1'
	option proxy_arp '1'
	option ocv '1'
