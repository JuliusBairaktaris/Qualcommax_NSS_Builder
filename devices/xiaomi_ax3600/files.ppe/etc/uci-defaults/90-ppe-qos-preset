# Preconfigure the hardware QoS for a Telekom FTTH 300/150 line
# (BRAS-advertised 330000/165000): hw_ppe.qos on the physical wan port at
# ~99%/~97% of the measured line, hardware flow offloading on. The ppe-qos
# package ships its own classifier defaults (small packets -> priority 5,
# DSCP EF -> 5). Everything is a uci default: it applies once on first boot
# and an existing configuration wins.

[ -f /etc/config/sqm ] || touch /etc/config/sqm

uci -q batch <<'EOF'
set firewall.@defaults[0].flow_offloading='1'
set firewall.@defaults[0].flow_offloading_hw='1'
delete sqm.@queue[0]
set sqm.hwppe=queue
set sqm.hwppe.enabled='1'
set sqm.hwppe.interface='wan'
set sqm.hwppe.download='325000'
set sqm.hwppe.upload='165000'
set sqm.hwppe.qdisc='fq_codel'
set sqm.hwppe.script='hw_ppe.qos'
set sqm.hwppe.linklayer='none'
commit firewall
commit sqm
EOF

exit 0
